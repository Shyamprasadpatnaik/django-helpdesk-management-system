# Django Secret Key & Debug Mode
SECRET_KEY=django-insecure-jkpaper-ticket-system-prod-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL)
# Set USE_SQLITE=True if MySQL server is not locally running during development
USE_SQLITE=False
DB_NAME=ticket_management
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Email Configuration (SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@company.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=JK Paper Mill Helpdesk <helpdesk@company.com>

# AI Chatbot Configuration
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
